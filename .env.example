# FinCred environment configuration
# Copy this file to .env.local and adjust values for your machine.

# Secret used to sign short-lived access tokens. Use at least 32 random bytes.
AUTH_SECRET=change-me-to-a-long-random-demo-secret

# Database driver: sqlite for local development, postgres for production/Azure.
FINCRED_DB_DRIVER=sqlite

# PostgreSQL connection string. Required when FINCRED_DB_DRIVER=postgres.
# Example Azure form:
# DATABASE_URL=postgresql://user:password@server.postgres.database.azure.com:5432/fincred?sslmode=require
DATABASE_URL=

# PostgreSQL pool size. Optional; defaults to 10.
FINCRED_PG_POOL_MAX=10

# Force TLS when the connection string does not include sslmode=require.
FINCRED_PG_SSL=false

# SQLite database file. Relative paths resolve from the project root.
FINCRED_DB_PATH=data/finecred.db

# Directory for synthetic sample uploads. Never place real financial documents here.
FINCRED_UPLOAD_DIR=data/uploads

# Maximum synthetic attachment size in megabytes.
FINCRED_MAX_UPLOAD_MB=5

# Seed illustrative demo accounts and sample transactions.
# Defaults to true outside production and false in production.
FINCRED_SEED_DEMO=true
FINCRED_SEED_SAMPLE=true

# Production refuses SQLite unless this explicit override is set.
FINCRED_ALLOW_SQLITE_PRODUCTION=false

# Set to production only when serving over HTTPS; enables secure cookies.
FINCRED_ENV=development
